DATABASE_URL="mysql://root@localhost:3306/soft_inmo"
JWT_SECRET="genera-una-clave-larga-y-aleatoria"
APP_DOMAIN="softinmo.com"
PORT=3001
UPLOAD_DIR="uploads"

# --- Fase 4: inteligencia artificial (opcional) ---
# Sin clave, el sistema redacta con plantillas propias y el asistente sigue funcionando.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"
# Pon "off" para que este servidor no ejecute las automatizaciones diarias.
AUTOMATIONS_SCHEDULER="on"

# --- Fase 5 ---
# Solo para desarrollo: permite webhooks hacia http://localhost. En producción déjalo vacío.
WEBHOOK_ALLOW_PRIVATE=""
